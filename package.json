{
  "name": "rodkexpressapp",
  "version": "2.0.1",
  "description": "test of express",
  "main": "app.js",
  "scripts": {
    "test:integration": "NODE_ENV=test nyc mocha 'test/globalHooks.js' 'test/integration/**/*test.js' --timeout 30000 --reporter=tap",
	"test": "[ \"$CI\" = \"true\" ] && npm run test:integration || npm run test:unit",
    "test:unit": "NODE_ENV=test nyc mocha 'test/unit/*test.js' --reporter=tap",
    "proxy": "~/cloud-sql-proxy crucial-garden-217908:us-central1:howardinstance",
    "dbcreate": "mysql -u root -p --host 127.0.0.1 --port 3306 --get-server-public-key < db/databaseCreate.txt",
    "dbcreate:test": "mysql -u root -p --host 127.0.0.1 --port 3306 --get-server-public-key < db/testDatabaseCreate.txt",
    "prestart": "db-migrate up --env prod",
    "start": "node app.js"
  },
  "author": "Howard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodkwithnasa/rodkexpressapp.git"
  },
  "dependencies": {
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "express": "^5.2.1",
    "mysql2": "^3.18.0"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  }
}
